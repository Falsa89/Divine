  "purpose": "View-only preview route counterpart of the FUTURE live Guild War battle replay (/battle-replay). Adds an isolated, deeplink-only preview route + 4 gated backend endpoints under /api/battle-replay-preview/*. Default-disabled (HTTP 503). When enabled, returns a deterministic Guild War replay payload compliant with the v35 schema and a display-only playback envelope with viewer_kind=guild_war_view. No live /battle-replay route created. No Guild War runtime mutation. No war_score/guild_points mutation. No reward grant.",

  "feature_flag": "BATTLE_REPLAY_PREVIEW_ENABLED",
  "default_runtime_enabled": false,
  "default_http_status": 503,
  "viewer_kind": "guild_war_view",
  "endpoint_namespace": "/api/battle-replay-preview",
  "endpoints": [
    {"method": "GET",  "path": "/api/battle-replay-preview/config",                  "purpose": "disabled/default config and safety flags"},
    {"method": "GET",  "path": "/api/battle-replay-preview/sample-guild-war-replay", "purpose": "deterministic v35-compliant Guild War replay sample"},
    {"method": "POST", "path": "/api/battle-replay-preview/validate-replay-payload", "purpose": "validates supplied replay payload shape against v35 required fields"},
    {"method": "POST", "path": "/api/battle-replay-preview/playback-preview",         "purpose": "display-only playback envelope; viewer_kind=guild_war_view; runner_mode=replay_view; never reruns battle"}
  ],

  "frontend_route": {
    "path": "frontend/app/battle-replay-preview.tsx",
    "deeplink": "/battle-replay-preview",
    "linked_from_home_menu_guild_war_story_combat": false,
    "reward_claim_button": false,
    "commit_button": false,
    "war_score_commit_button": false,
    "calls_api_battle_simulate": false,
    "calls_api_story_battle": false,
    "writes_async_storage": false,
    "reuses_visual_battle_preview_shell": true,
    "local_adapter": "adaptReplayPayloadForShell"
  },

  "payload_schema_source": "data/design/guild_war_replay/guild_war_replay_payload_schema_v1.json",
  "contract_source": "data/design/guild_war_replay/guild_war_autoresolve_replay_link_contract_v1.json",

  "sample_payload_defaults": {
    "viewer_kind": "guild_war_view",
