{
  "policy_name": "GuildWarReplayPrivacyPolicy",
  "version": 1,
  "created_at_utc": "2026-05-31T17:45:00Z",
  "runtime_activation": false,

  "no_pii_in_share_payload": true,
  "redact_other_players": true,
  "redact_account_identifiers": true,
  "redact_email_phone_pushtoken_ip": true,
  "redact_real_world_location": true,

  "redactable_fields": [
    "attacker_snapshot.player_account_id",
    "defender_snapshot.player_account_id",
    "attacker_snapshot.email",
    "defender_snapshot.email",
    "attacker_snapshot.phone",
    "defender_snapshot.phone",
    "attacker_snapshot.push_token",
    "defender_snapshot.push_token",
    "attacker_snapshot.ip",
    "defender_snapshot.ip",
    "attacker_snapshot.real_name",
    "defender_snapshot.real_name",
    "attacker_snapshot.country_precise",
    "defender_snapshot.country_precise"
  ],

  "public_safe_fields": [
    "guild_id_attacker",
    "guild_id_defender",
    "guild_name_attacker",
    "guild_name_defender",
    "hero_id",
    "hero_level",
    "hero_quality",
    "hero_elements",
    "hero_factions",
    "playback_timeline",
    "result_summary",
    "war_score_delta_display_only"
  ],

  "share_payload_rules": {
    "must_redact_other_player_pii": true,
    "must_not_include_account_email": true,
    "must_not_include_account_phone": true,
    "must_not_include_push_token": true,
    "must_not_include_ip": true,
    "must_not_include_real_name": true,
    "must_keep_guild_level_metadata": true
  }
}
