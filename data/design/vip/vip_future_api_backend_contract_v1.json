      "design_only": true,
      "request_shape": {
        "user_id": "string",
        "linked_purchase_id": "string",
        "delta_vip_points": 0,
        "source": "iap_purchase_paid_crystal_component",
        "idempotency_key": "string"
      },
      "response_shape": {
        "status": "APPLIED|DUPLICATE|REJECTED|FEATURE_DISABLED",
        "vip_points_after": 0,
        "new_tier": 0
