{
  "task_origin": "COSMETIC-SKIN-TITLE-SYSTEM-A",
  "document": "title_catalog_schema_v1",
  "version": "v1",
  "mode": "DESIGN_ONLY",
  "design_only": true,
  "runtime_attached": false,
  "battle_runtime_attached": false,
  "required_fields": [
    "title_id", "display_name", "rarity", "source_type", "scope_type",
    "equip_limit_group", "bonus_profile", "unlock_condition_ids",
    "seasonality", "server_first_allowed", "design_only",
    "runtime_attached", "battle_runtime_attached"
  ],
  "field_specs": {
    "title_id":            {"type": "string", "pattern": "^title_[a-z0-9_]+$", "unique": true},
    "display_name":        {"type": "string", "min_len": 1, "max_len": 64},
    "rarity":              {"type": "enum", "values": ["common","rare","epic","legendary","mythic","divine"]},
    "source_type":         {"type": "enum", "values": ["premium_paid","top_up_milestone","pvp_achievement","tower_achievement","affinity_max_milestone","titan_hunt","guild_war","hero_star_achievement","server_first","seasonal_event","zodiac_house_commander","battle_power_milestone","event_wins_milestone"]},
    "scope_type":          {"type": "enum", "values": ["account_wide","server_bound"]},
    "equip_limit_group":   {"type": "const", "const": "active_title", "note": "Hard limit 1 active title per player."},
    "bonus_profile":       {"type": "object", "required": ["target","bonuses"], "target_values": ["team","player","account_server"], "bonuses_max_count": 5},
    "unlock_condition_ids":{"type": "array", "item_type": "string", "min_len": 1},
    "seasonality":         {"type": "enum", "values": ["permanent","seasonal","server_first_locked"]},
    "server_first_allowed":{"type": "bool"},
    "design_only":         {"type": "const", "const": true},
    "runtime_attached":    {"type": "const", "const": false},
    "battle_runtime_attached": {"type": "const", "const": false}
  },
  "forbidden_fields": ["db_id","mongo_oid","applied_to_combat","buffs_active","battle_wiring"],
  "max_active_title_per_player": 1
}
