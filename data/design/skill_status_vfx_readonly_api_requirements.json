    "No battle behavior changes",
    "No frontend HP bar/status icon UI changes",
    "No skill/status/VFX live activation",
    "GET /api/heroes remains 100",
    "Borea remains hidden/pending",
    "Legacy borea remains hidden/non-official"
  ],
  "report_required_sections": [
    "Files installed from ZIP",
    "Files created/modified by implementation",
    "Requirements validator output",
    "Endpoint smoke results",
    "Runtime smoke",
    "Safety checks",
    "Explicit confirmation that catalogs are read-only and not connected to battle runtime"
  ]
}
