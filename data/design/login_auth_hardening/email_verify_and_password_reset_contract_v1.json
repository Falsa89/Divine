{
  "task_id": "PROJECT_LOGIN_AUTH_HARDENING",
  "track": "C",
  "track_name": "EMAIL_VERIFY_AND_PASSWORD_RESET_CONTRACT",
  "verdict": "TRACK_C_EMAIL_VERIFY_AND_PASSWORD_RESET_CONTRACT_READY",
  "design_only": true,
  "runtime_implementation_in_this_pack": false,
  "real_email_sending": false,
  "smtp_provider_external": false,
  "db_migration": false,
  "description": "Contratto inert (design-only) per email verification + password reset. Nessuna implementazione runtime in questo pack. Nessun invio email reale. Nessun provider SMTP esterno collegato.",
  "email_verify_flow": {
    "endpoints_design": [
      {"method": "POST", "path": "/api/auth/email/verify/request", "auth": "bearer", "body": {}, "design_response": {"status": 202, "body": {"sent": true, "channel": "design_only_inert"}}},
      {"method": "POST", "path": "/api/auth/email/verify/confirm", "auth": "none",   "body": {"token": "<one_time_token>"}, "design_response": {"status": 200, "body": {"email_verified": true}}}
    ],
    "token_policy": {
      "length_bytes": 32,
      "encoding": "hex",
      "hashed_at_rest": true,
      "ttl_minutes": 30,
      "single_use": true,
      "rate_limit_per_email_per_hour": 3
    },
    "db_schema_design": {
      "collection": "auth_email_verify_tokens",
      "fields": ["id", "user_id", "token_hash", "created_at", "expires_at", "used_at"],
      "indexes_design": ["user_id", "expires_at"],
      "migration_in_this_pack": false
    },
    "frontend_screen_design": "frontend/app/auth/email-verify.tsx (design-only; non implementato qui)"
  },
  "password_reset_flow": {
    "endpoints_design": [
      {"method": "POST", "path": "/api/auth/password/reset/request", "auth": "none", "body": {"email": "<email>"}, "design_response": {"status": 202, "body": {"sent": true, "channel": "design_only_inert"}, "note": "always 202 anche se email non esiste, per evitare user enumeration"}},
      {"method": "POST", "path": "/api/auth/password/reset/confirm", "auth": "none", "body": {"token": "<one_time_token>", "new_password": "<new>"}, "design_response": {"status": 200, "body": {"password_reset": true}}}
    ],
    "token_policy": {
      "length_bytes": 32,
      "encoding": "hex",
      "hashed_at_rest": true,
      "ttl_minutes": 30,
      "single_use": true,
      "rate_limit_per_email_per_hour": 3,
      "invalidates_existing_jwt_sessions": true
    },
    "password_policy": {
      "min_length": 8,
      "forbid_equal_to_previous": false,
      "hashed_with": "bcrypt.hashpw"
    },
    "db_schema_design": {
      "collection": "auth_password_reset_tokens",
      "fields": ["id", "user_id", "token_hash", "created_at", "expires_at", "used_at"],
      "indexes_design": ["user_id", "expires_at"],
      "migration_in_this_pack": false
    },
    "frontend_screen_design": "frontend/app/auth/password-reset.tsx (design-only; non implementato qui)"
  },
  "forbidden_in_this_pack": [
    "implementazione runtime di endpoint email/password reset",
    "connessione SMTP/SendGrid/Mailgun/etc.",
    "migrazione MongoDB per le 2 nuove collection",
    "modifica .env per aggiungere secrets SMTP",
    "invio email reali (anche di test)"
  ],
  "language": "it"
}
