{
  "schema_version": "hero_asset_expected_folder_schema_v1",
  "layout": {
    "root": "<asset_source_root>/<hero_id>/",
    "required_files": [
      "splash.png",
      "no_background.png",
      "combat_base.png",
      "idle.png",
      "attack.png",
      "skill.png",
      "hit.png",
      "death.png"
    ],
    "optional_files": [
      "chibi_home.png"
    ]
  },
  "naming_rules": {
    "hero_id_pattern": "^[a-z0-9_]+$",
    "file_extension": "png",
    "case_sensitive": false
  },
  "db_writes": 0,
  "real_asset_import": false,
  "file_copy_enabled": false
}
