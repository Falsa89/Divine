{
  "rules_name": "live_announcement_dynamic_event_rules_v1",
  "pack": "MEGA_RELEASE_ACCELERATION_42_v93",
  "qa_simulation_only": true,
  "production_broadcast": false,
  "push_notification_live": false,
  "real_user_data_required": false,
  "privacy_safe_alias_only": true,
  "anti_spam_rules_present": true,
  "dynamic_events": [
    {"event_type": "six_star_pull", "channel": "global", "trigger": "player pulled a 6-star hero (alias-safe)", "template": "{alias} ha invocato un eroe 6\u2605!", "throttle_per_minute": 5, "alias_only": true, "min_visibility_threshold": "global_top_pulls"},
    {"event_type": "native_six_star_star_up", "channel": "global", "trigger": "native 6-star milestone star-up", "template": "{alias} ha portato a 6\u2605 nativo {hero_alias}!", "throttle_per_minute": 5, "alias_only": true, "min_visibility_threshold": "global"},
    {"event_type": "arena_top3_change", "channel": "arena", "trigger": "arena top 3 change", "template": "Nuovo Top 3 Arena: {alias_a} > {alias_b} > {alias_c}", "throttle_per_minute": 2, "alias_only": true, "min_visibility_threshold": "arena_channel"},
    {"event_type": "live_event_kill", "channel": "events", "trigger": "player kill in live event", "template": "{alias} ha abbattuto {target_alias}", "throttle_per_minute": 10, "alias_only": true, "min_visibility_threshold": "event_channel"},
    {"event_type": "live_event_kill_streak", "channel": "events", "trigger": "kill streak threshold", "template": "{alias} STREAK x{streak}!", "throttle_per_minute": 5, "alias_only": true, "min_visibility_threshold": "event_channel"},
    {"event_type": "global_ranking_change", "channel": "global", "trigger": "top-N global ranking change", "template": "{alias} entra in Top {rank} globale", "throttle_per_minute": 3, "alias_only": true, "min_visibility_threshold": "top_100"},
    {"event_type": "top_player_online", "channel": "global", "trigger": "top player just came online", "template": "{alias} (#{rank}) e' online", "throttle_per_minute": 1, "alias_only": true, "min_visibility_threshold": "top_50"},
    {"event_type": "guild_boss_milestone", "channel": "guild", "trigger": "guild/live boss HP threshold", "template": "{guild_alias}: boss {boss_alias} al {percent}%!", "throttle_per_minute": 5, "alias_only": true, "min_visibility_threshold": "guild_channel"},
    {"event_type": "community_prestige_event", "channel": "community", "trigger": "prestige/community milestone", "template": "Evento community: {milestone_label}", "throttle_per_minute": 2, "alias_only": true, "min_visibility_threshold": "community_channel"}
  ],
  "anti_spam": {
    "max_per_user_per_minute": 3,
    "max_per_channel_per_minute": 30,
    "global_burst_cap": 100,
    "dedupe_window_seconds": 60,
    "throttle_strategy": "token_bucket"
  },
  "channels": ["global", "system", "events", "arena", "guild", "community"],
  "alias_safety": {
    "alias_format": "qa_alias_{number}",
    "do_not_emit_real_user_id": true,
    "do_not_emit_real_user_name": true,
    "do_not_emit_email": true,
    "do_not_emit_ip": true
  },
  "safety": {
    "db_writes": 0,
    "production_broadcast": false,
    "push_notification_live": false,
    "real_user_pii": false,
    "reward_live": false
  }
}
