{
  "task_origin":"SLC-H-REQUEST-RESPONSE-SCHEMAS","version":"v1","mode":"DESIGN_ONLY_CONTRACT_ONLY",
  "design_only":true,"runtime_attached":false,"db_write":false,
  "schemas":{
    "public_server_summary":{
      "type":"object",
      "required":["server_id","server_name","region","status","opened_at","is_legacy_default","new_account_eligible","existing_account_eligible"],
      "properties":{
        "server_id":{"type":"string","example":"s1"},
        "server_name":{"type":"string","example":"Greek S1"},
        "region":{"type":"string","example":"global"},
        "status":{"type":"string","enum":["planned","open","crowded","closed_to_new","merge_pending","merged","archived"]},
        "opened_at":{"type":"string","format":"date-time-or-pre_multishard_era"},
        "closed_at":{"type":["string","null"]},
        "merged_into_server_id":{"type":["string","null"]},
        "is_legacy_default":{"type":"boolean"},
        "new_account_eligible":{"type":"boolean"},
        "existing_account_eligible":{"type":"boolean"},
        "labels":{"type":"array","items":{"type":"string","enum":["new","recommended","crowded","closed_to_new","merge_pending","merged","archived"]}}
      },
      "never_returns":["shard_host","connection_string","internal_load_metrics","raw_user_counts"]
    },
    "GET_api_servers_response":{
      "type":"object",
      "required":["servers","second_server_opening_allowed","legacy_default_server_id"],
      "properties":{
        "servers":{"type":"array","items":{"$ref":"#/schemas/public_server_summary"}},
        "second_server_opening_allowed":{"type":"boolean","const_until_flag_set":false},
        "legacy_default_server_id":{"type":"string","const":"s1"}
      }
    },
    "account_server_profile":{
      "type":"object",
      "required":["server_id","account_id","created_at","is_active_session","is_legacy_implicit"],
      "properties":{
        "server_id":{"type":"string"},
        "account_id":{"type":"string"},
        "server_name":{"type":"string"},
        "server_status":{"type":"string"},
        "created_at":{"type":"string","format":"date-time"},
        "is_active_session":{"type":"boolean"},
        "is_legacy_implicit":{"type":"boolean","description":"true when profile derived from SLC-G migration default s1 without a stored profile row"},
        "derived_from":{"type":"string","enum":["slc_g_migration","explicit_profile_row"]}
      }
    },
    "GET_api_account_server_profiles_response":{
      "type":"object",
      "required":["profiles","active_server_id","second_server_opening_allowed"],
      "properties":{
        "profiles":{"type":"array","items":{"$ref":"#/schemas/account_server_profile"}},
        "active_server_id":{"type":"string","default_legacy":"s1"},
        "second_server_opening_allowed":{"type":"boolean"}
      }
    },
    "POST_api_account_server_profiles_select_body":{
      "type":"object",
      "required":["server_id"],
      "properties":{
        "server_id":{"type":"string"},
        "force_create_if_missing":{"type":"boolean","default":false,"future_only":true},
        "client_session_id":{"type":"string","optional":true}
      }
    },
    "active_server_resolution":{
      "type":"object",
      "required":["server_id","server_name","server_status","account_id","resolved_via"],
      "properties":{
        "server_id":{"type":"string"},
        "server_name":{"type":"string"},
        "server_status":{"type":"string"},
        "account_id":{"type":"string"},
        "resolved_via":{"type":"string","enum":["explicit_select","legacy_default_s1","stored_active_server","single_profile_only"]},
        "second_server_opening_allowed":{"type":"boolean"}
      }
    },
    "failure_response":{
      "type":"object",
      "required":["error_code","error_kind","http_status","message","retryable"],
      "properties":{
        "error_code":{"type":"string"},
        "error_kind":{"type":"string"},
        "http_status":{"type":"integer"},
        "message":{"type":"string"},
        "retryable":{"type":"boolean"},
        "merged_redirect_server_id":{"type":["string","null"]}
      }
    }
  }
}
