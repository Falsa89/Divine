{
  "task_origin":"SLC-G-BACKUP-MANIFEST-CONTRACT","version":"v1","mode":"GATED_DRY_RUN_FIRST",
  "design_only":true,"runtime_attached":false,"battle_runtime_attached":false,
  "migration_applied":false,"db_write":false,
  "backup_strategy":{
    "approach":"mongodump_per_collection_with_checksum_and_doc_count",
    "per_collection_artifacts":[
      "bson_dump",
      "json_metadata_count_and_indexes",
      "sha256_checksum",
      "timestamp_utc"
    ],
    "snapshot_naming":"backup_slc_g_pre_default_s1_<UTC_ISO>_<git_short_sha>",
    "storage_target":"design_only_path_placeholder_pending_env",
    "storage_target_env_var":"SLC_G_BACKUP_TARGET_DIR",
    "min_retention_days":30
  },
  "collections_required_in_backup":[
    "users","user_heroes","teams","inventory","story_progress",
    "guilds","user_affinity_state","gift_transaction_ledger",
    "user_gift_inventory","servers","server_profiles",
    "server_wallets_free","gacha_history","arena_rankings",
    "server_cosmetics","equipped_cosmetics","event_progress",
    "accounts_wallet_paid","accounts_wallet_paid_ledger","account_cosmetics"
  ],
  "backup_must_be_completed_and_verified_before_any_write":true,
  "backup_checksum_must_be_recorded":true,
  "backup_record_must_include":{
    "per_collection_doc_count_at_backup_time":true,
    "per_collection_index_list_at_backup_time":true,
    "af2n_state_snapshot":true,
    "api_smoke_snapshot":true,
    "protected_file_sha256_list":true,
    "git_short_sha":true,
    "timestamp_utc":true
  },
  "design_only_until_storage_env_provided":true
}
