  "design_only": true,
  "runtime_attached": false,
  "battle_runtime_attached": false,
  "override_events": {
    "christmas":      {"window_utc": "Dec 18-Dec 31", "priority": "P1", "global": true, "can_delay_must_catch_up": true,  "can_delete_must_catch_up": false},
