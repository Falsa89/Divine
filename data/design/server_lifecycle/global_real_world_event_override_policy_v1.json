  },
  "precedence_order": [
    {"priority": "P0", "category": "safety_or_maintenance", "description": "Maintenance/security holds override everything."},
    {"priority": "P1", "category": "real_world_seasonal",   "description": "Globally synchronized real-world events."},
    {"priority": "P2", "category": "merge_recovery",        "description": "Merge Recovery Season events / Catch-Up Pool."},
    {"priority": "P3", "category": "server_age_critical",   "description": "Server-age must_catch_up events."},
    {"priority": "P4", "category": "weekly_filler",         "description": "Compressible/skippable filler events."}
  ],
  "rules": {
    "real_world_can_delay_must_catch_up_but_not_delete": true,
    "merge_recovery_can_pause_for_real_world_seasonal": true,
    "merge_recovery_resumes_after_real_world_window": true,
    "borea_must_never_appear_in_any_real_world_event": true
  }
}
