    "halloween":      {"window_utc": "Oct 24-Nov 02", "priority": "P1", "global": true, "can_delay_must_catch_up": true,  "can_delete_must_catch_up": false},
    "valentine":      {"window_utc": "Feb 10-Feb 17", "priority": "P1", "global": true, "can_delay_must_catch_up": true,  "can_delete_must_catch_up": false},
    "summer":         {"window_utc": "Jul 15-Aug 15", "priority": "P1", "global": true, "can_delay_must_catch_up": true,  "can_delete_must_catch_up": false},
    "anniversary_v1": {"window_utc": "variable",      "priority": "P1", "global": true, "can_delay_must_catch_up": false, "can_delete_must_catch_up": false},
