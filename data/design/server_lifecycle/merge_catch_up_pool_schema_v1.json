{
  "task_origin": "SERVER-LIFECYCLE-CALENDAR-A",
  "document": "merge_catch_up_pool_schema_v1",
  "version": "v1",
  "mode": "DESIGN_ONLY",
  "design_only": true,
  "runtime_attached": false,
  "battle_runtime_attached": false,
  "required_fields": [
    "merge_group_id","source_server_ids","target_server_id","baseline_progress_index",
    "missed_milestone_ids","recovery_class","affected_server_ids","banner_pool","shop_pool",
    "compressed_rewards","start_at","end_at","max_parallel_banners",
    "pity_policy","purchase_limit_policy","fairness_notes",
    "design_only","runtime_attached","battle_runtime_attached"
  ],
  "field_specs": {
    "merge_group_id":         {"type": "string", "pattern": "^merge_[a-z0-9_]+$"},
    "source_server_ids":      {"type": "array", "item_type": "string", "min_len": 2},
    "target_server_id":       {"type": "string", "pattern": "^s[0-9]+$"},
    "baseline_progress_index":{"type": "object", "shape": {"server_day_equivalent": "integer", "milestone_index": "integer"}},
    "missed_milestone_ids":   {"type": "array", "item_type": "string"},
    "recovery_class":         {"type": "enum", "values": ["must_catch_up","optional_catch_up","compress","skip"]},
    "affected_server_ids":    {"type": "array", "item_type": "string"},
    "banner_pool":            {"type": "array", "item_type": "object", "item_shape": {"banner_id": "string", "slot": "integer"}},
    "shop_pool":              {"type": "array", "item_type": "object", "item_shape": {"shop_id": "string", "compressed_from_event_ids": "array"}},
    "compressed_rewards":     {"type": "array", "item_type": "object", "item_shape": {"reward_profile_id": "string", "weight": "number"}},
    "start_at":               {"type": "datetime_iso8601_utc"},
    "end_at":                 {"type": "datetime_iso8601_utc"},
    "max_parallel_banners":   {"type": "integer", "min": 1, "max": 6},
    "pity_policy":            {"type": "object", "shape": {"inherit_best_from_source": "bool", "shared_across_pool": "bool"}},
    "purchase_limit_policy":  {"type": "object", "shape": {"daily_caps": "object", "weekly_caps": "object"}},
    "fairness_notes":         {"type": "string"},
    "design_only":            {"type": "const", "const": true},
    "runtime_attached":       {"type": "const", "const": false},
    "battle_runtime_attached":{"type": "const", "const": false}
  },
  "example_pool": {
    "merge_group_id": "merge_alpha_2026q3",
    "source_server_ids": ["s4","s7","s11"],
    "target_server_id": "s4",
    "baseline_progress_index": {"server_day_equivalent": 220, "milestone_index": 18},
    "missed_milestone_ids": ["cal_d030_server_boss_intro","cal_d075_tower_trial","cal_d090_titan_hunt_intro"],
    "recovery_class": "must_catch_up",
    "affected_server_ids": ["s7","s11"],
    "banner_pool": [{"banner_id":"banner_counter_meta_placeholder_002","slot":1},{"banner_id":"banner_starter_meta_placeholder_001","slot":2}],
    "shop_pool": [{"shop_id":"merge_shop_alpha_v1","compressed_from_event_ids":["material_week_starter_v1","top_up_minor_v1"]}],
    "compressed_rewards": [{"reward_profile_id":"merge_carnival_v1","weight":1.0}],
    "start_at": "2026-08-01T10:00:00Z",
    "end_at":   "2026-08-15T10:00:00Z",
    "max_parallel_banners": 3,
    "pity_policy": {"inherit_best_from_source": true, "shared_across_pool": true},
    "purchase_limit_policy": {"daily_caps": {"crystal_pack_basic": 5}, "weekly_caps": {"crystal_pack_premium": 2}},
    "fairness_notes": "Pity progress carried over per-account from best source-server pity bucket. Exclusive cosmetics from skip-class are not added; only non-exclusive compressed.",
    "design_only": true, "runtime_attached": false, "battle_runtime_attached": false
  }
}
