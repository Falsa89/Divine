    "http_methods_supported": ["GET"],
    "http_methods_explicitly_rejected": ["POST", "PUT", "PATCH", "DELETE"],
    "rate_limit_recommended": "reuse global rate limiter; preview endpoint is read-only and cheap",
    "telemetry_recommended": [
      "counter: server_profiles_preview_calls_total{result}",
      "counter: server_profiles_preview_503_total"
    ]
