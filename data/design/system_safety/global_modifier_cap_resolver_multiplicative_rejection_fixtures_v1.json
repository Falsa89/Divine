      "description": "Two additive (3+4=7) plus two multiplicative (5+6, rejected). Sum=7, clamp=7.",
      "context": "pvp",
      "mock_sources": [
        {"id": "additive_a", "pct": 3, "stacking_mode": "additive"},
        {"id": "additive_b", "pct": 4},
        {"id": "mult_a", "pct": 5, "stacking_mode": "multiplicative"},
