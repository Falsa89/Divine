  "summary": "STACK-D fixtures formalize the rejection / preview-only normalization of multiplicative-stacking sources inside global_modifier_cap_resolver.preview_combined_cap. Every case must keep the resolver OFF/inert: runtime_attached=false, applied_to_combat=false, db_write=false. Multiplicative sources are EXCLUDED from the additive sum and reported under `mock_sources_rejected_multiplicative` with reason=multiplicative_rejected_preview_only.",

  "global_pvp_combined_target_cap_pct": 12,
  "multiplicative_policy": "rejected_preview_only",

  "cases": [
    {
      "id": "case_md_01_collection_multiplicative",
      "description": "Collection multiplicative source (5%) MUST be rejected; additive sum stays 0.",
      "context": "pvp",
      "mock_sources": [
        {"id": "collection_mult", "pct": 5, "stacking_mode": "multiplicative"}
      ],
      "expected": {
        "additive_sum_pct_preview": 0,
        "multiplicative_rejected_count": 1,
        "clamped_pct_preview_le_target": true,
        "clamped_pct_preview_equals": 0,
        "is_disabled_envelope": true
      }
    },
    {
      "id": "case_md_02_affinity_multiplicative",
      "description": "Affinity multiplicative source (6%) rejected.",
      "context": "pvp",
      "mock_sources": [
        {"id": "affinity_mult", "pct": 6, "stacking_mode": "multiplicative"}
      ],
      "expected": {
        "additive_sum_pct_preview": 0,
        "multiplicative_rejected_count": 1,
        "clamped_pct_preview_le_target": true,
        "clamped_pct_preview_equals": 0,
