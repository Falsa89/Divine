  "summary": "AF2-L-K6-PREP \u2014 Test plan for real load-testing of the disabled gift-spend endpoint using k6 or Locust. SAFE: no live spend, no DB write, asserts disabled-state (423) and Borea-alias-state (404) under sustained load.",

  "endpoint_under_test": "POST /api/affinity/gift-spend",
  "endpoint_expected_status_disabled": 423,
  "endpoint_expected_status_borea_alias": 404,
  "endpoint_expected_status_runtime_on": "N/A_until_AF2N_approved",

  "assets": {
    "k6_script": "/app/loadtests/affinity_gift_spend_disabled.k6.js",
    "locust_script": "/app/loadtests/affinity_gift_spend_disabled_locust.py",
    "python_substitute": "/app/backend/scripts/run_affinity_gift_spend_full_disabled_load_probe.py"
  },

  "profiles": [
    {"name": "smoke", "vus": 10, "duration_seconds": 15, "target_p95_ms": 500, "target_5xx_rate": 0.0},
    {"name": "baseline", "vus": 50, "duration_seconds": 30, "target_p95_ms": 500, "target_5xx_rate": 0.0},
    {"name": "stress", "vus": 200, "duration_seconds": 60, "target_p95_ms": 800, "target_5xx_rate": 0.0}
  ],
  "thresholds": {
    "http_req_failed_rate_max": 0.01,
    "checks_kind_disabled_rate_min": 1.0,
    "checks_kind_borea_rate_min": 1.0,
    "http_req_duration_p95_ms_max": 500
  },

  "safety_constraints": [
    "endpoint MUST be disabled (HTTP 423) for the entire run",
    "any HTTP 200 from /api/affinity/gift-spend FAILS the test immediately",
    "NO real gift_spend executed; NO DB write reachable",
    "Borea aliases (borea/greek_borea/primordial_gaia) MUST return 404",
