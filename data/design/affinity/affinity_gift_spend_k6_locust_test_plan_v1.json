    "do NOT run against a production environment without explicit user approval",
    "if any 5xx burst exceeds 1%, abort the run and create an incident artifact"
  ],

  "required_invariants_before_run": [
    "/api/heroes count == 100",
    "Borea aliases hidden from /api/heroes",
    "POST /api/affinity/gift-spend returns 423 (single-request preflight)",
    "baseline v6 clean",
    "AF2-K commit applied, ledger rows == 0",
    "AF2-M product_signoff == true (other signoffs may remain false)"
  ],
  "required_invariants_after_run": [
    "ledger rows == 0",
    "feature_flag_currently_enabled == false",
    "gift-spend still returns 423"
  ],

  "observability": {
    "metrics_to_collect": ["http_req_duration_p50", "http_req_duration_p95", "http_req_duration_p99",
                          "http_req_failed_rate", "checks_disabled_rate", "checks_borea_rate"],
    "export_to": ["/app/data/design/affinity/affinity_gift_spend_k6_run_result_v1.json (future)"]
  },

  "safety_flags": {
    "runtime_attached": false,
    "db_write": false,
    "feature_flag_currently_enabled": false,
    "hidden_aliases_blocked": ["borea","greek_borea","primordial_gaia"],
