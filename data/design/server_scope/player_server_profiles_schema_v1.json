  },
  "indexes": [
    {"fields":["account_id","server_id"],"unique":true,"name":"psp_account_server_unique"},
    {"fields":["server_id"],"unique":false,"name":"psp_server_id"},
    {"fields":["account_id"],"unique":false,"name":"psp_account_id"},
    {"fields":["server_id","last_played_at"],"unique":false,"name":"psp_server_last_played"},
    {"fields":["server_id","account_level"],"unique":false,"name":"psp_server_level"}
