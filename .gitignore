# ============================================================
# .gitignore — Repository hygiene (consolidato in Pack 115F)
# ============================================================

# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials

# RM1.17-J — DB backups must never be committed (GH 100MB limit)
backend/backups/
*.zip

# RM1.20-A — Roster audit & soft-deactivation plan reports (mai committare)
backend/reports/
!backend/reports/.gitkeep

# ------------------------------------------------------------
# Pack 115F — Repo hygiene: Python bytecode / cache artifacts
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
